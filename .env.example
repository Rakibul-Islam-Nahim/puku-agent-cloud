# Settings for docker-compose.yml. Make .env with
#   ./deploy/scripts/stack-init.sh
# which copies this file and fills every `<generated>` value with a fresh
# secret. Then fill the values marked <yours> and run `docker compose up -d`.
# Never commit .env.
#
# Optional settings stay commented out: an uncommented `KEY=` passes an empty
# string, and the typed ones reject it ("cannot parse integer from empty
# string").

# ── What runs on this host ───────────────────────────────────────────────
# Main server: control,tunnel,worker.  Any other server that runs VMs: worker.
COMPOSE_PROFILES=control,tunnel,worker

# ── Endpoints ────────────────────────────────────────────────────────────
#   puku-agent-cloud (controld)  https://agent.api.puku.sh   served by this stack
#   puku-memory-service          https://memory.api.puku.sh  controld calls it
#   puku-skills-service          https://skill.api.puku.sh   controld calls it
#   PukuBot                      https://app.bot.puku.sh     calls controld
#
# agent.api.puku.sh: a Cloudflare tunnel whose public hostname
# agent.api.puku.sh points at http://controld:7770. Paste its token here.
# CAUTION: a token of the tunnel that serves agent.api.puku.sh today adds this
# host as another connector of it, and Cloudflare then splits live traffic
# between the two stacks. Use a new tunnel, or stop the old stack first.
CLOUDFLARE_TUNNEL_TOKEN=<yours>

PUKU_MEMORY_URL=https://memory.api.puku.sh
# The memory service's API key: the same value as PUKU_MEMORY_SERVICE_KEY on
# the memory service. Without it memory stays off and controld says so.
PUKU_MEMORY_SERVICE_KEY=<yours>
# Only if memory.api.puku.sh is behind Cloudflare Access: both, or neither.
#PUKU_MEMORY_ACCESS_CLIENT_ID=
#PUKU_MEMORY_ACCESS_CLIENT_SECRET=

PUKU_SKILLS_URL=https://skill.api.puku.sh
# Must equal PUKU_SKILLS_OPERATOR_TOKEN on the skills service. Used when a
# session has no caller bearer of its own (schedules, pkc_ keys).
PUKU_SKILLS_TOKEN=<yours>

# Users' puku platform logins are verified here; each caller gets their own org.
PUKU_API_URL=https://chat.api.puku.sh
PUKU_MCP_PROXY_URL=https://mcp.proxy.puku.sh

# PukuBot (app.bot.puku.sh) is a client of controld. In puku-bot's own .env:
#   PUKU_AGENT_CLOUD_URL=http://controld:7770          (same host, puku-link network)
#                     or https://agent.api.puku.sh      (another host)
#   PUKU_AGENT_CLOUD_API_KEY=<from: docker compose exec controld puku-controld gen-key --org pukubot --name puku-bot>
#
# Base URL of machine links (noVNC and other guest pages). puku-bot on this
# host opens them over puku-link, so the default is right then. Anywhere
# else, a hostname of its own routed to controld (the same tunnel), never
# agent.api.puku.sh itself: guest pages must not share the dashboard's origin.
PUKU_LINKS_URL=http://controld:7770

# ── Secrets (stack-init.sh fills these; back them up) ───────────────────
# Encrypts stored credentials, snapshot keys and disk-backup keys. LOSING IT
# MAKES THEM UNREADABLE. Keep an offline copy.
PUKU_SECRET_KEY=<generated>
POSTGRES_PASSWORD=<generated>
MINIO_ROOT_USER=puku-admin
MINIO_ROOT_PASSWORD=<generated>

# ── Object storage: MinIO in this stack ─────────────────────────────────
# This host's LAN address: workers and clients use presigned URLs to it, so
# it cannot be `minio` or 127.0.0.1 (controld runs in a container).
MINIO_BIND=<this host's LAN IP>
PUKU_R2_ENDPOINT=http://<this host's LAN IP>:9000
PUKU_R2_BUCKET=puku-agent-cloud
PUKU_R2_REGION=us-east-1
PUKU_R2_ACCESS_KEY_ID=puku-cloud
PUKU_R2_SECRET_ACCESS_KEY=<generated>
# A host path on a disk of its own for the backups, instead of a named volume.
#MINIO_DATA=/srv/minio

# ── controld ─────────────────────────────────────────────────────────────
PUKU_AUTH=required
# Where workers reach controld: 127.0.0.1 when the only worker is this host,
# this host's LAN IP when other servers run workers.
CONTROLD_BIND=127.0.0.1
# Guest image of sessions. Load it into every worker's msb store
# (docs/DOCKER-STACK.md, "Guest images").
#PUKU_AGENT_IMAGE=puku-agent:0.1.0
# Engines callers may ask for. Add cloud_hypervisor once a Cloud Hypervisor
# worker (on the host, deploy/scripts/setup-worker.sh) has joined.
#PUKU_ENGINES_ALLOWED=libkrun
#PUKU_ENGINE_DEFAULT=libkrun
#PUKU_MACHINE_IMAGE=pukubot-computer:latest
#PUKU_MACHINE_MAX_CPUS=8
#PUKU_MACHINE_MAX_MEMORY_MIB=16384
#PUKU_DEFAULT_DISALLOWED_TOOLS=WebSearch,WebFetch
#PUKU_RETENTION_DAYS=14

# ── Shared disks on Ceph (production) ──────────────────────────────────
# Set the pool on every host. /etc/ceph needs ceph.conf and the
# client.puku keyring; on the main server let controld read the keyring:
#   chgrp 10001 /etc/ceph/ceph.client.puku.keyring && chmod 640 /etc/ceph/ceph.client.puku.keyring
#PUKU_RBD_POOL=puku-sessions
#PUKU_CEPH_USER=puku
#CEPH_CONF_DIR=/etc/ceph
#PUKU_DISK_BACKUP_INTERVAL_S=3600
#PUKU_STORAGE_GC_DRY_RUN=true

# ── workerd (profile worker) ─────────────────────────────────────────────
# Same host as controld: ws://127.0.0.1:7770/v1/worker. Another server:
# ws://<main server's LAN IP>:7770/v1/worker.
PUKU_CONTROLD_URL=ws://127.0.0.1:7770/v1/worker
PUKU_WORKER_NAME=bm1
# pkw_... from: docker compose exec controld puku-controld gen-worker-token --name bm1
# (run on the main server), then `docker compose up -d` again.
PUKU_WORKER_TOKEN=
# Open internet for guests: right while only our own team uses it. With other
# tenants, set PUKU_MULTI_TENANT=1 and an allowlist instead.
PUKU_EGRESS_UNRESTRICTED=true
#PUKU_MULTI_TENANT=1
#PUKU_EGRESS_ALLOW=puku.sh,github.com,githubusercontent.com,pypi.org,npmjs.org
#PUKU_CPU_OVERCOMMIT=1.0

RUST_LOG=info
