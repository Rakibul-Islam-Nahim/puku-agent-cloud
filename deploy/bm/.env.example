# Copy to .env on the bare-metal host. Do not commit the filled copy.

# Image published by .github/workflows/publish-image.yml
CONTROLD_IMAGE=docker.io/poridhi/puku-controld:0.1.0

POSTGRES_PASSWORD=

# Connections controld holds to its database (default 16). Keep it below the
# database's own limit: Supabase's session pooler allows 15 per pool, and going
# over fails requests as "max clients reached".
#PUKU_DATABASE_MAX_CONNECTIONS=10

# Where the published port binds. 0.0.0.0 for a dev box reached directly by
# IP; 127.0.0.1 when a tunnel or reverse proxy fronts it.
BIND_ADDR=0.0.0.0

# Only for `docker compose --profile tunnel up -d`. Leave blank in dev.
#   cloud.puku.sh -> http://controld:7770
#CLOUDFLARE_TUNNEL_TOKEN=

# 'required' in any environment reachable from the internet.
PUKU_AUTH=required

# Per-user identity. Callers presenting their own puku platform bearer are
# verified against {PUKU_API_URL}/auth/verify and provisioned into their own
# personal org on first use, so each person's sessions run on their own
# token and their own quota. Turn PUKU_PLATFORM_AUTH off only if every
# caller should share one pkc_ key.
PUKU_API_URL=https://chat.api.puku.sh
PUKU_PLATFORM_AUTH=true

# Guest image every session microVM boots.
PUKU_AGENT_IMAGE=docker.io/poridhi/puku-agent:0.1.0

# Per-worker tokens: mint one per host with
#   docker compose exec controld puku-controld gen-worker-token --name box-1
# and leave the shared secret disabled.
PUKU_ALLOW_SHARED_WORKER_TOKEN=false
#PUKU_WORKER_TOKEN=

# bypassPermissions is right for a single-tenant box (the microVM is the
# boundary). Set 'default' the moment more than one tenant shares the fleet.
PUKU_PERMISSION_CEILING=bypassPermissions

# Tools every session refuses unless it names a policy of its own.
# Comma-separated; empty (the default) restricts nothing.
#
# This is the only fleet-wide tool knob. Without it a workaround has to be
# repeated by every caller on every run, and webhook-fired sessions cannot
# express one at all -- they are built with empty lists and have no request
# to inherit from.
#
# The usual reason to set it: puku-cli 1.8.49 crashes on WebSearch usage
# accounting ("Cannot read properties of undefined (reading
# 'web_search_requests')") and the session is recorded failed. Setting
#   PUKU_DEFAULT_DISALLOWED_TOOLS=WebSearch,WebFetch
# applies that workaround once, for the whole box. Leave it empty to allow
# them and accept the risk.
#
# A default, not a ceiling: a caller who names any tool replaces this
# outright, including asking for fewer restrictions.
#PUKU_DEFAULT_DISALLOWED_TOOLS=
#PUKU_DEFAULT_ALLOWED_TOOLS=

# Cloudflare R2 (S3 API). The account-scoped endpoint, not the bucket URL.
PUKU_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
PUKU_R2_BUCKET=puku-agent-cloud
# "auto" for Cloudflare R2. "us-east-1" for MinIO or real S3 -- SigV4 signs
# the region, so the wrong value fails as a signature error.
PUKU_R2_REGION=auto
PUKU_R2_ACCESS_KEY_ID=
PUKU_R2_SECRET_ACCESS_KEY=

# ── Multi-tenant posture ──────────────────────────────────────────────────
# Off by default, and it should stay off on anything more than one person
# uses. It controls whether PUKU_AI_API_KEY, PUKU_OAUTH_TOKEN,
# PUKU_SESSION_FILE and the static PUKU_GIT_TOKEN may reach a guest when the
# caller stored no credential of their own.
#
# Each of those is a cross-tenant hole: a model credential silently bills
# the operator for someone who never stored one, and the git PAT clones any
# repo it can read for whoever names it. With this off, such a session is
# refused up front and told what to store.
#PUKU_ALLOW_OPERATOR_CREDENTIALS=true

# OAuth issuer used to mint a short-lived bearer from a stored refresh
# token, so scheduled runs keep working after a login lapses.
#PUKU_AUTH_ISSUER=https://puku.sh/api/oauth

# puku-skills-service (its own deployment; see that repo's deploy/bm).
# PUKU_SKILLS_TOKEN must equal that service's PUKU_SKILLS_OPERATOR_TOKEN.
#
# NOT loopback. controld runs in a container, where 127.0.0.1 is that
# container -- it resolves, connects to nothing, and the agent quietly runs
# without its packs. Two shapes work:
#
#   http://172.17.0.1:7870   both stacks on one box, over the docker0 bridge.
#                            Only works if the skills service is PUBLISHED
#                            there: BIND_ADDR=172.17.0.1 in
#                            puku-skills-service/deploy/bm/.env. Its default
#                            used to be 0.0.0.0 and the docs said 127.0.0.1,
#                            either of which makes this address time out.
#   https://skills.puku.sh   the registry behind its own tunnel. Costs a
#                            round trip per dispatch; needs no shared network.
#
# controld probes this at startup and logs an error naming the address if it
# cannot reach it, so a wrong value shows up in `docker compose logs` rather
# than as an agent that ignores your instructions.
PUKU_SKILLS_URL=http://172.17.0.1:7870
#PUKU_SKILLS_TOKEN=

# REQUIRED. Encrypts stored credentials at rest -- generate with
#   openssl rand -hex 32
# Without it a caller's own bearer cannot be stored, so no session has a
# credential of its own and every one is refused at dispatch (or, with
# PUKU_ALLOW_OPERATOR_CREDENTIALS on, billed to the operator).
# Losing it makes already-stored credentials unreadable, so back it up.
PUKU_SECRET_KEY=

# Optional -- leave these COMMENTED OUT to accept the defaults. An
# uncommented `KEY=` passes an empty string, which the typed settings
# reject outright ("cannot parse integer from empty string").
PUKU_MCP_PROXY_URL=https://mcp.proxy.puku.sh
#PUKU_AI_BASE_URL=
#PUKU_DEFAULT_MAX_TURNS=
#PUKU_RETENTION_DAYS=

# Operator-wide credentials. Both are IGNORED unless
# PUKU_ALLOW_OPERATOR_CREDENTIALS=true, which is off by default -- see the
# multi-tenant note above.
#
# Unattended runs do not need these: each user stores a refresh token once
#   POST /v1/credentials {"kind":"refresh","value":"..."}
# and controld mints a short-lived bearer from it at every dispatch, so
# scheduled jobs keep running on that user's own identity and bill.
#
# If you do set one, replace the whole value. A literal placeholder here
# breaks every clone with "URL rejected: Malformed input to a URL function".
#PUKU_AI_API_KEY=
#PUKU_GIT_TOKEN=

# ── Engines and machines ─────────────────────────────────────────────────
# Engines a caller may ask for, and what a request naming none gets. A worker
# advertises cloud_hypervisor only when its own checks pass (Step 7b).
#PUKU_ENGINES_ALLOWED=libkrun,cloud_hypervisor
#PUKU_ENGINE_DEFAULT=libkrun
# Machines (puku-bot computers): the default image, and the ceilings every
# request is clamped to (defaults 4 CPUs, 8192 MiB).
#PUKU_MACHINE_IMAGE=pukubot-computer:latest
#PUKU_MACHINE_MAX_CPUS=8
#PUKU_MACHINE_MAX_MEMORY_MIB=16384
# Base URL machine links are minted under -- whatever the caller that opens
# them can reach. A same-host caller on the puku-link network uses
# http://controld:7770; anyone else needs the public hostname.
#PUKU_LINKS_URL=http://controld:7770
# Snapshots: auto (on when PUKU_R2_* and PUKU_SECRET_KEY are both set),
# true, or false. Workers PUT snapshot parts straight to PUKU_R2_ENDPOINT,
# so every worker host must reach it, not only controld.
#PUKU_SNAPSHOTS=auto
#PUKU_SNAPSHOT_KEEP=5
#PUKU_SNAPSHOT_RETAIN_DESTROYED_DAYS=7

# Concurrent sessions a worker accepts. Unset (or 0) sizes it from that
# host's own cores and memory, and re-sizes it as memory frees. Pin a number
# only if you want the host to hold back capacity it actually has.
#PUKU_CAPACITY_SLOTS=0

# Error reporting and tracing. Leave unset and Sentry is off entirely: the
# client is created disabled and every call becomes a no-op, so both services
# behave exactly as they do without it. Errors are always sent when a DSN is
# present; traces are sampled (see crates/puku-controld/src/sampling.rs).
#SENTRY_DSN=
#SENTRY_ENVIRONMENT=production

RUST_LOG=info
